# ─────────────────────────────────────────────────────────────
#  AIVANA V2 – Template des variables d'environnement
# ─────────────────────────────────────────────────────────────

# ── GLOBALES ──
NODE_ENV=development
JWT_SECRET=generer_une_cle_longue_et_aleatoire

# ── API GATEWAY (La seule URL publique pour le Frontend) ──
# En production (Vercel), pointe vers l'URL publique de Render
NEXT_PUBLIC_API_GATEWAY=http://localhost:3000/api

# ── AUTH SERVICE ──
AUTH_PORT=3001
OAUTH_GOOGLE_CLIENT_ID=votre_id_google
OAUTH_GOOGLE_CLIENT_SECRET=votre_secret_google
OAUTH_CALLBACK_URL=http://localhost:3001/auth/callback
FRONTEND_URL=http://localhost:3000

# ── DATABASE SERVICE ──
DB_PORT=3002
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=oflyes
POSTGRES_PASSWORD=oflyes_password
POSTGRES_DB=oflyes_db
# DATABASE_URL est prioritaire en production
DATABASE_URL=postgresql://user:pass@host:port/dbname

# ── AI SERVICE ──
AI_PORT=3003
GROQ_API_KEY=votre_cle_groq

# ── NOTIFICATIONS SERVICE ──
NOTIF_PORT=3004
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email
SMTP_PASS=votre_mot_de_passe_application

# ── TRAVEL ENGINE SERVICE ──
TRAVEL_ENGINE_PORT=3005

# ── SYNC WORKER ──
# URLs internes pour la communication entre services
DB_URL=http://database-service:3002
AI_URL=http://ai-service:3003
NOTIF_URL=http://notifications-service:3004
METRICS_URL=http://metrics-service:3009

# ── METRICS SERVICE ──
METRICS_PORT=3009
