{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*",
        "../auth/src/**/*",
        "../database/src/**/*",
        "../ai/src/**/*",
        "../metrics/src/**/*",
        "../notifications/src/**/*",
        "../partner-service/src/**/*",
        "../payments/src/**/*",
        "../sync-worker/src/**/*",
        "../travel-engine/src/**/*"
    ],
    "exclude": [
        "node_modules",
        "**/*.spec.ts"
    ]
}