# Supabase (Project Settings > API Keys et Data API)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Copilote IA (console.groq.com > API Keys)
GROQ_API_KEY="gsk_..."

# Captcha anti-robot Cloudflare Turnstile (facultatif : sans ces clés, pas de captcha)
# dash.cloudflare.com > Turnstile > Add widget. La clé secrète va AUSSI dans
# Supabase > Authentication > Attack Protection > Enable Captcha (Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
